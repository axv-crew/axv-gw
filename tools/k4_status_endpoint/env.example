# AXV API Configuration - K4.1 Status Endpoint
# Copy to .env and customize for your environment

# ==============================================================================
# Server Configuration
# ==============================================================================

# API Host and Port
API_HOST=0.0.0.0
API_PORT=8080

# Environment (development, staging, production)
ENVIRONMENT=development

# API Version
API_VERSION=0.1.9

# ==============================================================================
# Health Check URLs
# ==============================================================================

# AXV Gateway Health Check
# URL to gateway's healthz endpoint
GATEWAY_HEALTHZ_URL=http://127.0.0.1:8000/axv/healthz

# n8n Workflow Engine Health Check
# URL to n8n's health endpoint (if available)
N8N_HEALTHZ_URL=http://n8n.axv.life/healthz

# RAG (Atlas EDGE) Health Check
# URL to RAG system's health endpoint (future)
RAG_HEALTHZ_URL=http://rag.axv.life/healthz

# ==============================================================================
# Health Check Settings
# ==============================================================================

# Timeout for each health check (seconds)
# Recommended: 1-3 seconds
HEALTHCHECK_TIMEOUT=2.0

# Retry attempts for failed health checks
HEALTHCHECK_RETRIES=1

# ==============================================================================
# Logging
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=json

# Log file path (leave empty for stdout only)
LOG_FILE=

# ==============================================================================
# Database (if needed)
# ==============================================================================

# PostgreSQL connection
# DATABASE_URL=postgresql://user:password@localhost:5432/axv_db

# Redis connection (for caching)
# REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Monitoring & Metrics
# ==============================================================================

# Enable Prometheus metrics endpoint
ENABLE_METRICS=true

# Metrics port (if different from main API port)
# METRICS_PORT=9090

# ==============================================================================
# Security
# ==============================================================================

# API Key for protected endpoints (if needed)
# API_KEY=your-secret-key-here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# Features Flags
# ==============================================================================

# Enable/disable specific features
FEATURE_NODES_STATUS=true
FEATURE_DETAILED_ERRORS=true

# ==============================================================================
# External Services
# ==============================================================================

# Slack webhook for alerts (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration key (optional)
# PAGERDUTY_INTEGRATION_KEY=your-key-here

# ==============================================================================
# Development Settings
# ==============================================================================

# Enable auto-reload in development
DEV_RELOAD=true

# Enable debug mode
DEBUG=false

# API documentation enabled
ENABLE_DOCS=true
